rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isAdminEmail() {
      return signedIn()
        && request.auth.token.email.lower() in [
          'henk.seegers1965@gmail.com',
          'hendrik.seegers1991@icloud.com',
          'hendrik.seegers@icloud.com',
          'henkseegers196565@hotmail.com',
          'seegershenk79@gmail.com',
          'iyersamir@gmail.com'
        ];
    }

    match /profiles/{userId}/{fileName} {
      allow read: if signedIn();
      allow write: if signedIn()
        && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Public blog covers and inline photos (visitor cards + post page)
    match /club-media/blog/{allPaths=**} {
      allow read: if true;
      allow write: if isAdminEmail()
        && request.resource.size < 12 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Public vlog recordings (page is public; iPhone must be able to play without login)
    match /club-media/vlogs/{allPaths=**} {
      allow read: if true;
      allow write: if isAdminEmail()
        && request.resource.size < 80 * 1024 * 1024
        && (
          request.resource.contentType.matches('video/.*')
          || request.resource.contentType.matches('audio/.*')
        );
    }

    // Club media for admin CMS (images, seminar files)
    match /club-media/{allPaths=**} {
      allow read: if signedIn();
      allow write: if isAdminEmail()
        && request.resource.size < 80 * 1024 * 1024
        && (
          request.resource.contentType.matches('image/.*')
          || request.resource.contentType.matches('audio/.*')
          || request.resource.contentType.matches('video/.*')
        );
    }
  }
}

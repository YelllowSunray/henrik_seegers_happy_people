{
  "name": "henrik_seegers_spiritual_club",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "admin:ensure-user": "node --env-file=.env.local scripts/ensure-admin-user.mjs",
    "admin:billing-on": "node --env-file=.env.local scripts/set-billing-flag.mjs true",
    "admin:billing-off": "node --env-file=.env.local scripts/set-billing-flag.mjs false",

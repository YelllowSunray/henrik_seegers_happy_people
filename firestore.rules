rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdminEmail() {
      return signedIn()
        && request.auth.token.email in [
          'henk.seegers1965@gmail.com'
        ];
    }

    function isAdmin() {
      return isAdminEmail()
        || (
          signedIn()
          && exists(/databases/$(database)/documents/members/$(request.auth.uid))
          && get(/databases/$(database)/documents/members/$(request.auth.uid)).data.isAdmin == true
        );
    }

    function billingOk() {
      return !exists(/databases/$(database)/documents/system/billing)
        || get(/databases/$(database)/documents/system/billing).data.overBudget != true;
    }

    match /members/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid;
      allow update: if signedIn() && (request.auth.uid == uid || isAdmin());
    }

    match /posts/{id} {
      allow read: if resource.data.membersOnly != true || signedIn();
      allow create, update, delete: if isAdmin() && billingOk();
    }

    match /videos/{id} {
      allow read: if resource.data.kind == 'sample' || signedIn();
      allow create, update, delete: if isAdmin() && billingOk();
    }

    match /quotes/{id} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin() && billingOk();
    }

    match /personalMessages/{id} {
      allow read: if signedIn()
        && (resource.data.toUserId == request.auth.uid
            || resource.data.toEmail == request.auth.token.email
            || isAdmin());
      allow create, delete: if isAdmin() && billingOk();
      allow update: if isAdmin() && billingOk()
        || (
          signedIn()
          && (
            resource.data.toUserId == request.auth.uid
            || resource.data.toEmail == request.auth.token.email
          )
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
        );
    }

    // Two-way chat between a member and Henk (admin)
    match /chats/{memberUid} {
      allow read: if signedIn() && (request.auth.uid == memberUid || isAdmin());
      allow create, update: if signedIn()
        && (request.auth.uid == memberUid || isAdmin());

      match /messages/{messageId} {
        allow read: if signedIn()
          && (request.auth.uid == memberUid || isAdmin());
        allow create: if signedIn() && (
          (
            request.auth.uid == memberUid
            && request.resource.data.senderId == request.auth.uid
            && request.resource.data.senderRole == 'member'
            && request.resource.data.text is string
            && request.resource.data.text.size() > 0
            && request.resource.data.text.size() < 4000
          )
          || (
            isAdmin()
            && request.resource.data.senderRole == 'admin'
            && request.resource.data.senderId == request.auth.uid
            && request.resource.data.text is string
            && request.resource.data.text.size() > 0
            && request.resource.data.text.size() < 4000
          )
        );
        allow update, delete: if isAdmin();
      }
    }

    match /events/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin() && billingOk();
    }

    match /system/{doc} {
      // Public read so the spend-cap banner works for everyone
      allow read: if true;
      allow write: if false;
    }
  }
}

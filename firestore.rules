rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && get(/databases/$(database)/documents/members/$(request.auth.uid)).data.isAdmin == true;
    }

    match /members/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid;
      allow update: if signedIn() && (request.auth.uid == uid || isAdmin());
    }

    match /posts/{id} {
      allow read: if resource.data.membersOnly != true || signedIn();
      allow write: if isAdmin();
    }

    match /videos/{id} {
      allow read: if resource.data.kind == 'sample' || signedIn();
      allow write: if isAdmin();
    }

    match /quotes/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /personalMessages/{id} {
      allow read: if signedIn()
        && (resource.data.toUserId == request.auth.uid
            || resource.data.toEmail == request.auth.token.email
            || isAdmin());
      allow write: if isAdmin();
    }

    match /events/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
